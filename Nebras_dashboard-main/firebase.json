{
  "database": {
    "rules": "database.rules.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "apphosting": [
    {
      "backendId": "nebras-dashboard",
      "rootDir": "./dashboard",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "dashboard/node_modules",
        "dashboard/.svelte-kit",
        "dashboard/build",
        "dashboard/.env",
        "dashboard/.env.*",
        "dashboard/secrets"
      ],
      "alwaysDeployFromSource": true
    }
  ]
}
