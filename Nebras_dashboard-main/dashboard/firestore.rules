rules_version = '2';

// ════════════════════════════════════════════════════════════════════
//  Cloud Firestore Rules — Nebras (Production-Strict)
//
//  المبدأ:
//    • قراءة عامّة لمحتوى التطبيق (sections + uploads + content_unified).
//    • كتابة مقيَّدة لمشرفي لوحة التحكّم فقط، عبر Custom Claim `role`
//      الذي يضبطه الخادم بعد قراءة `dashboard_users/{uid}` في RTDB
//      (مسارات `/api/auth/*` و`/api/admin/supervisors/*`).
//    • أيّ مسار آخر مرفوض افتراضياً (deny-by-default).
//
//  ملاحظة للعميل: بعد تسجيل الدخول وحصول الحساب على صلاحيات،
//  يجب استدعاء `firebase/auth.getIdToken(true)` لتحديث التوكن بالـ
//  claims الجديدة قبل أيّ كتابة (انظر src/lib/api/auth.js).
//
//  التعديلات السيرفريّة (Admin SDK) تتجاوز هذه القواعد طبيعيّاً،
//  وهي خطّ الدفاع الإضافي للكتابات المباشرة من المتصفّح.
// ════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function hasDashboardWrite() {
      return isSignedIn() && (
        request.auth.token.role == 'owner' ||
        request.auth.token.role == 'supervisor'
      );
    }

    // المالك وحده (وليس المشرفين العاديّين) — يُستخدم لمراجعة بلاغات
    // المحتوى المخالف وحذفه من واجهة الإشراف الخاصّة بالمالك.
    function hasOwnerRole() {
      return isSignedIn() && request.auth.token.role == 'owner';
    }

    // تحقّق إنشاء بلاغ من التطبيق — يُسمح لأيّ مستخدم (موقَّع أو ضيف)
    // بالإبلاغ، شرط وجود الحقول الأساسيّة وأن تكون الحالة 'pending'.
    function isValidContentReport() {
      return request.resource.data.keys().hasAll(
          ['contentId', 'reasonCode', 'status', 'createdAt'])
        && request.resource.data.contentId is string
        && request.resource.data.reasonCode is string
        && request.resource.data.status == 'pending';
    }

    // تحديث عدّادات المشاهدة من التطبيق — حقول محدودة فقط، بدون UID.
    function isEngagementCounterUpdate() {
      return resource != null
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['view_count', 'play_count', 'complete_count', 'last_played_at']);
    }

    // ─── Sections (sections_unified/main|sub|secondary) ─────────
    // مستند واحد لكلّ مستوى يحوي خريطة id→record. لا نقيّد بنية الخريطة
    // داخل Rules لأنّ ذلك يستوجب تكرار عشرات المفاتيح؛ التحقّق منها يجري
    // في كود الواجهة قبل الإرسال (moderator.js).
    match /sections_unified/{level} {
      allow read: if true;
      allow write: if hasDashboardWrite()
        && level in ['main', 'sub', 'secondary'];
    }

    // ─── ملفّات الرفع (مرايا متماثلة) ────────────────────────────
    // كلّ مستند يجب أن يحمل id/fileId — مطابق لقواعد RTDB القديمة.
    function validFileDoc() {
      return request.resource.data.keys().hasAny(['id', 'fileId']);
    }

    match /dashboard_uploads/{docId} {
      allow read: if true;
      allow create, update: if hasDashboardWrite() && validFileDoc();
      allow delete: if hasDashboardWrite();
    }

    match /content_unified_files/{docId} {
      allow read: if true;
      allow create: if hasDashboardWrite() && validFileDoc();
      allow update: if hasDashboardWrite() && validFileDoc();
      allow update: if isEngagementCounterUpdate();
      allow delete: if hasDashboardWrite();
    }

    // ─── سجلّات YouTube ─────────────────────────────────────────
    // يجب أن يحمل المستند id و video_url نصّيّاً (مطابق لـ RTDB).
    function validYoutubeDoc() {
      return request.resource.data.keys().hasAll(['id', 'video_url'])
        && request.resource.data.video_url is string
        && request.resource.data.video_url.size() > 0;
    }

    match /content_unified_youtube/{docId} {
      allow read: if true;
      allow create: if hasDashboardWrite() && validYoutubeDoc();
      allow update: if hasDashboardWrite() && validYoutubeDoc();
      allow update: if isEngagementCounterUpdate();
      allow delete: if hasDashboardWrite();
    }

    // تجميع أسبوعي للشعبية — يكتبه Admin SDK فقط (POST /api/admin/aggregates/popularity).
    match /aggregates_popular/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ─── بلاغات المحتوى المخالف (من التطبيق) ─────────────────────
    // الإنشاء متاح لأيّ مستخدم (موقَّع أو ضيف) للإبلاغ عن مخالفة.
    // القراءة والتحديث للمالك وحده عبر واجهة الإشراف الخاصّة به.
    // الحذف: للمالك، **أو** لصاحب البلاغ نفسه (reporterUid == uid) —
    // هذا الأخير يلبّي سياسة حذف بيانات Google Play: عند حذف الحساب
    // يحذف التطبيق بلاغات المستخدم بنفسه قبل إزالة الهويّة.
    match /content_reports/{reportId} {
      allow create: if isValidContentReport();
      allow read, update: if hasOwnerRole();
      allow delete: if hasOwnerRole()
        || (isSignedIn() && resource.data.reporterUid == request.auth.uid);
    }

    // ─── deny-by-default ────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
