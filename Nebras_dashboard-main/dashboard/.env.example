# Backend API base URL
VITE_API_BASE_URL=http://localhost:8000

# Firebase — انسخ هذا الملف إلى .env وعبّئ القيم من إعدادات مشروعك
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ─── Firebase Cloud Messaging (server-side — never prefix with VITE_) ──
# يُستخدم فقط داخل مسارات SvelteKit الخادمة (+server.js) لإرسال إشعارات FCM.
# لا تُعرَض أبداً للمتصفّح. احصل على ملف JSON من:
#   Firebase Console → Project Settings → Service accounts → Generate new private key
# ثم ضع محتوى الملف كاملاً كسلسلة واحدة (مع escape للأسطر الجديدة داخل private_key):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","...":"..."}
FIREBASE_SERVICE_ACCOUNT_JSON=

# (اختياري) مسار ملف JSON بدل إلصاقه نصاً في المتغيّر أعلاه.
# أيّ من الاثنين يعمل؛ إذا كان كلاهما موجوداً نستعمل JSON المباشر.
FIREBASE_SERVICE_ACCOUNT_PATH=

# اسم الـ topic الذي تشترك فيه جميع الأجهزة في التطبيق.
# يجب أن يتطابق مع القيمة المستخدمة داخل التطبيق (انظر firebase_notification_datasource.dart).
FCM_BROADCAST_TOPIC=nebras_all_users
