# Backend API base URL
VITE_API_BASE_URL=http://localhost:8000

# Firebase — انسخ هذا الملف إلى .env وعبّئ القيم من إعدادات مشروعك
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ─── Firebase Secondary (OldApp / archived project) ────────────────
# مشروع Firebase ثانوي يُستخدم فقط للقراءة من Firestore لربط أقسام
# لوحة التحكّم بمصادر حقيقية في تطبيق قديم. اتركه فارغًا إن لم تكن
# بحاجة لهذه الميزة — ستُخفي الواجهة خياراته تلقائيًّا.
VITE_OLDAPP_API_KEY=
VITE_OLDAPP_AUTH_DOMAIN=
VITE_OLDAPP_PROJECT_ID=
VITE_OLDAPP_STORAGE_BUCKET=
VITE_OLDAPP_MESSAGING_SENDER_ID=
VITE_OLDAPP_APP_ID=

# اسم (بالعربية/اللغة المستخدمة) القسم الرئيسي المضيف الذي إذا اختاره
# المشرف ظهرت قوائم OldApp في النماذج. مثال افتراضي: "دروس بتدكصهك".
VITE_OLDAPP_HOST_SECTION_NAME=

# ─── Firebase Secondary (MshcatApp / 1:1 project) ─────────────────
# مشروع `mshcat-fkdl`. يُكتَب فيه مباشرةً من لوحة التحكّم عند اختيار
# المصدر = Mshcat. اتركه فارغًا لإخفاء خياره من الواجهة.
VITE_MSHCAT_API_KEY=
VITE_MSHCAT_AUTH_DOMAIN=
VITE_MSHCAT_PROJECT_ID=
VITE_MSHCAT_STORAGE_BUCKET=
VITE_MSHCAT_MESSAGING_SENDER_ID=
VITE_MSHCAT_APP_ID=

# ─── Firebase Admin SDK — Nebras (server-side — never prefix with VITE_) ──
# مفتاح خدمة المشروع الأساسيّ. يُستخدم لإرسال إشعارات FCM والتحقّق من ID
# tokens وقراءة/كتابة dashboard_users. اتركه فارغاً واستخدم الاسم الأحدث
# (NEBRAS_SERVICE_ACCOUNT_*) للمشاريع الجديدة — كلاهما مدعوم للتوافق الرجعي.
#
# تعليمات: Firebase Console → Project Settings → Service accounts → Generate
# new private key، ثمّ ضع محتوى الملف كاملاً كسلسلة واحدة (مع escape لأسطر
# private_key):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","...":"..."}
FIREBASE_SERVICE_ACCOUNT_JSON=

# (اختياري) مسار ملف JSON بدل إلصاقه نصاً في المتغيّر أعلاه.
FIREBASE_SERVICE_ACCOUNT_PATH=

# (بديل أحدث — مستحسن) نفس المفتاح أعلاه لكن بأسماء صريحة تميّز Nebras
# عن باقي المشاريع. إن ضُبط أيّ منها فله الأسبقيّة على FIREBASE_SERVICE_ACCOUNT_*.
NEBRAS_SERVICE_ACCOUNT_JSON=
NEBRAS_SERVICE_ACCOUNT_PATH=
# متغيّر موحّد اختياري يقبل JSON مدمجاً أو مساراً (Heuristic).
NEBRAS_SERVICE_ACCOUNT=

# ─── Firebase Admin SDK — Mshcat (`mshcat-fkdl`) ───────────────────
# مفتاح خدمة مشروع Mshcat الثانويّ. ضعه لتفعيل نقاط /api/mshcat/*
# (الكتابة الإداريّة من جانب الخادم بدل المتصفّح). اتركه فارغاً لتعمل
# الواجهة بـ Web SDK القديم مؤقّتاً مع ظهور 501 عند استدعاء الـ API.
MSHCAT_SERVICE_ACCOUNT_JSON=
MSHCAT_SERVICE_ACCOUNT_PATH=
MSHCAT_SERVICE_ACCOUNT=
# (اختياري) دلو التخزين لمشروع Mshcat — مطلوب مستقبلاً لرفع الملفات عبر admin.storage().
MSHCAT_STORAGE_BUCKET=

# ─── Firebase Admin SDK — OldApp (`mxqp-8d1e8`) ────────────────────
# مفتاح خدمة مشروع OldApp الثانويّ (التطبيق القديم). يُستخدم مع نقاط
# /api/oldapp/* للكتابة الإداريّة من الخادم.
OLDAPP_SERVICE_ACCOUNT_JSON=
OLDAPP_SERVICE_ACCOUNT_PATH=
OLDAPP_SERVICE_ACCOUNT=
OLDAPP_STORAGE_BUCKET=

# اسم الـ topic الذي تشترك فيه جميع الأجهزة في التطبيق.
# يجب أن يتطابق مع القيمة المستخدمة داخل التطبيق (انظر firebase_notification_datasource.dart).
FCM_BROADCAST_TOPIC=nebras_all_users

# ─── Noor Library importer ─────────────────────────────────────
# مسار Chrome/Chromium الذي يستخدمه Puppeteer. في Cursor Cloud غالباً:
# /usr/local/bin/google-chrome
PUPPETEER_EXECUTABLE_PATH=

# رابط كتاب محدد من مكتبة نور، أو اتركه فارغاً ليبحث السكربت عن العنوان
# الافتراضي: "النصائح حول التعليمات العلمية السادة".
NOOR_BOOK_URL=
NOOR_BOOK_TITLE=
NOOR_BOOK_SOURCE_URL=
